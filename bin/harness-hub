#!/data/data/com.termux/files/usr/bin/bash
# harness-hub — TUI installer menu for AI coding harnesses on Termux
# WIP skeleton: reads manifests/*.json, renders categories, runs recipes.
set -euo pipefail
HUB_DIR="$(cd "$(dirname "$0")/.." && pwd)"
MANIFESTS="$HUB_DIR/manifests"

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required: pkg install jq" >&2
  exit 1
fi

Crim=$'\e[38;5;161m'
Rst=$'\e[0m'

categories=(
  "1" "Platform Giants  (claude, codex, gemini, grok)"
  "2" "Claw Fleet       (openclaw, zeroclaw, picoclaw, ironclaw)"
  "3" "Open Engines     (opencode, cline, aider, goose)"
  "4" "Standalone Cores (dsh-mini, antigravity, openclaude)"
  "5" "Swarms           (cmux, herdr, multica)"
  "6" "SecEng           (pentestcode)"
  "7" "Routing          (omniroute, 9router, cliproxyapi)"
  "8" "MCP & Tooling    (bwb-browser, curl-cffi)"
  "9" "Doctor           (health check)"
  "0" "Exit"
)

while true; do
  clear
  printf "%s\n" "${Crim}╾━━━━━ HARNESS HUB ━━━━━◆${Rst}"
  printf "%s\n" "  Native Termux installer — no proot"
  printf "\n"
  i=0
  for ((i=0; i<${#categories[@]}; i+=2)); do
    printf "  [%s] %s\n" "${categories[$i]}" "${categories[$((i+1))]}"
  done
  printf "\n  Choice: "
  read -r choice
  case "$choice" in
    0) exit 0 ;;
    9) bash "$HUB_DIR/recipes/doctor.sh" || true ;;
    [1-8])
      echo "  -- listing manifests in category $choice --"
      for f in "$MANIFESTS"/*.json; do
        [ -e "$f" ] && continue
      done 2>/dev/null
      for f in "$MANIFESTS"/*.json; do
        [ -f "$f" ] || continue
        cat_sel=$(jq -r '.category // empty' "$f" 2>/dev/null)
        case "$choice" in
          1) want=platform-giants ;; 2) want=claw-fleet ;;
          3) want=open-engines ;;    4) want=standalone-cores ;;
          5) want=swarms ;;          6) want=seceng ;;
          7) want=routing ;;         8) want=mcp-tooling ;;
        esac
        if [ "$cat_sel" = "$want" ]; then
          printf "   • %s (%s)\n" \
            "$(jq -r .name "$f")" "$(jq -r .version "$f")"
        fi
      done
      printf "\n  Press enter to continue..."
      read -r
      ;;
    *) echo "  invalid" ; sleep 1 ;;
  esac
done

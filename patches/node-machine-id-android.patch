--- pristine-nmi/index.js	1985-10-26 04:15:00.000000000 -0400
+++ /data/data/com.termux/files/home/omniroute/node_modules/node-machine-id/index.js	2026-09-30 12:30:04.471994480 -0400
@@ -12,7 +12,12 @@
